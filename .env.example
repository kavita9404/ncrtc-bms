# Copy to .env. Never commit the real .env.
# Used by docker compose (SECRET_KEY) and by the backend when run directly.

# Required in any shared or deployed environment. Generate with: openssl rand -hex 32
SECRET_KEY=change-me

# Leave unset for local SQLite (bms.db). Compose sets this for you.
DATABASE_URL=postgresql+psycopg2://bms:bms@localhost:5432/bms

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ACCESS_TOKEN_MINUTES=480

# Live-map simulator
TICK_SECONDS=5
TICK_SPEED_MULTIPLIER=8
